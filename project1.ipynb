    "import pandas as pd\n",
    "from scipy.stats import f_oneway, kruskal\n",
    "from statsmodels.formula.api import ols\n",
    "from statsmodels.stats.anova import anova_lm\n",
    "from statsmodels.stats.multicomp import pairwise_tukeyhsd\n",
    "# Example: 'Education Level' -> 'Education_Level'\n",
    "df = df.rename(columns=lambda c: c.strip().replace(' ', '_'))\n",
    "# One-way ANOVA\n",
    "model = ols('Salary ~ C(Education_Level)', data=df).fit()\n",
    "anova_tbl = anova_lm(model, typ=2)\n",
    "print(anova_tbl)\n",
    "\n",
    "\n",
    "tukey = pairwise_tukeyhsd(endog=df['Salary'],\n",
    "                          groups=df['Education_Level'],\n",
    "                          alpha=0.05)\n",
    "print(tukey)\n"
   ]
