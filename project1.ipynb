    "from scipy.stats import pearsonr, spearmanr\n",
    "import statsmodels.api as sm\n",
    "\n",
    "# Pearson correlation (linear) and p-values\n",
    "r_exp, p_exp = pearsonr(df['Years of Experience'], df['Salary'])\n",
    "r_age, p_age = pearsonr(df['Age'], df['Salary'])\n",
    "print(\"Pearson: r_exp=\", r_exp, \"p=\", p_exp, \"  r_age=\", r_age, \"p=\", p_age)\n",
    "\n",
    "# Spearman (monotonic) if you want robustness to nonlinearity/outliers\n",
    "qwe = {\"Bachelor's\": 0, \"Master's\":1,\"PhD\":2}\n",
    "df[\"Education_ordinal\"] = df[\"Education Level\"].map(qwe) \n",
    "rho_edu, p_edu = spearmanr(df['Education_ordinal'], df['Salary'])  # map BSc=1, MSc=2, PhD=3 first\n",
    "print(\"Spearman (Edu vs Salary): rho=\", rho_edu, \"p=\", p_edu)\n",
    "\n",
    "# Simple linear regression (slope significance for Experience)\n",
    "X = sm.add_constant(df['Years of Experience'])\n",
    "y = df['Salary']\n",
    "res = sm.OLS(y, X).fit()\n",
    "print(res.summary())  # p-value for 'Experience' coefficient (slope)\n"
   ]
