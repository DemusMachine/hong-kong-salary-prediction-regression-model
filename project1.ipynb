    "print(f\"Master's to PhD: ${int(phd_avg - masters_avg)} ({int(((phd_avg/masters_avg)-1)*100)}%)\")\n",
    "print(f\"Bachelor's to PhD: ${int(phd_avg - bachelors_avg)} ({int(((phd_avg/bachelors_avg)-1)*100)}%)\")"
